{
  // Point the Java extension at a JDK 25. Adjust the path to your install:
  //   macOS (Homebrew/SDKMAN): ~/.sdkman/candidates/java/25-zulu
  //   Linux (Azul deb/rpm):    /usr/lib/jvm/zulu25
  //   Windows:                 C:\\Program Files\\Zulu\\zulu-25
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-25",
      "path": "${env:JAVA_HOME}",
      "default": true
    }
  ],
  "java.compile.nullAnalysis.mode": "automatic",
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.format.settings.url": "https://raw.githubusercontent.com/google/styleguide/gh-pages/eclipse-java-google-style.xml",
  "editor.formatOnSave": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  // No engine forced here on purpose: works with whichever of Docker/Podman/etc.
  // is on your PATH. Override containers.containerClient / docker.dockerPath /
  // dev.containers.dockerPath locally if you want to pin one.
  "yaml.schemas": {
    "kubernetes": "deploy/k8s/*.yaml"
  }
}
